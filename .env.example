# AI provider selection
# auto precedence: OpenAI -> Anthropic -> Ollama -> OpenAI-compatible local
AI_PROVIDER=auto

# OpenAI cloud (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic cloud (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama local/offline (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# OpenAI-compatible local server, e.g. LM Studio or llama.cpp server (optional)
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_API_KEY=
LOCAL_OPENAI_MODEL=

# OBD-II Adapter (optional — auto-detected if not set)
# Linux default: /dev/ttyUSB0
# macOS default: /dev/cu.usbserial-XXXXXXXX
# Windows default: COM3 (check Device Manager)
OBD_PORT=
OBD_BAUDRATE=
# OBD protocol — set this to skip slow auto-detection (~30s)
# 6 = ISO 15765-4 CAN 11/500 (most 2008+ cars, confirmed working)
# Leave blank to auto-detect (slower but works on any car)
OBD_PROTOCOL=

# Database (optional — defaults to data/sessions.db)
DB_PATH=data/sessions.db
